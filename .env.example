# Copie para .env e preencha com seus valores reais (NUNCA faça commit do .env)
MONGO_URI=
GEMINI_API_KEY=
JWT_SECRET=
PORT=3000

# Opcionais
JWT_EXPIRES_IN=1d
ANALYTICS_TIMEZONE=America/Sao_Paulo
# Quantos proxies existem na frente do app: 1 = só Render; 2 = Vercel -> Render
TRUST_PROXY=

# Deploy Vercel + Render
# Domínio(s) do front no Vercel que podem abrir o WebSocket (separe por vírgula)
CORS_ORIGINS=
# URL pública do backend para o WebSocket (no Render é preenchida sozinha via RENDER_EXTERNAL_URL)
SOCKET_PUBLIC_URL=
